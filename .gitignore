# --------------------------------------------------------------------------
# Secrets - never commit
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml
data/.keyring

# --------------------------------------------------------------------------
# Runtime state: SQLite database and generated job artifacts.
# Every job's guide sheet, decks, imagery and narration is regenerated by the
# pipeline, and the database holds the encrypted API key and token ledger.
# --------------------------------------------------------------------------
data/

# --------------------------------------------------------------------------
# Derived cache: rebuilt automatically from assets/ppt_template.pptx
# --------------------------------------------------------------------------
assets/lada_working_template.pptx

# Palette-keyed graphics generated on demand by lada/graphics.py
assets/career_shaper_bar_*.png
assets/career_shaper_reversed_*.png
assets/image_placeholder_*.png
assets/audio_badge_*.png
assets/audio_icon_probe.png

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

